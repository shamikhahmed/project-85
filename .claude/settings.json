{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "~/Capricorn-Brain"
    ],
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Skill",
      "NotebookEdit",
      "TodoWrite"
    ],
    "ask": [],
    "deny": []
  },
  "skipDangerousModePermissionPrompt": true
}
